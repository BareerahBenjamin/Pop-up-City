# 本机开发。生产用 deploy/server.env.example，不能复制开发环境到公网。
NODE_ENV=development
HOST=127.0.0.1
PORT=3300
PUBLIC_ORIGIN=http://127.0.0.1:3300
DATABASE_PATH=./data/popup-city.sqlite
# 用 node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))" 生成
AUTH_PEPPER=
# disabled：公开页可用，登录关闭；smtp：配置下方参数后启用邮箱登录
MAIL_MODE=disabled
FROM_EMAIL=info@0xherstory.cn
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
