NODE_ENV=production
HOST=127.0.0.1
PORT=3300
# 已选定活动站根域名；正式上线前确认解析和 HTTPS。
PUBLIC_ORIGIN=https://kunyuan.site
DATABASE_PATH=/var/lib/herstory-popup-city/popup-city.sqlite
# 在服务器生成随机值，保护权限，之后保持稳定。
AUTH_PEPPER=
# 邮件功能保留且为上线验收项；SMTP 配置完成后改为 smtp。
MAIL_MODE=disabled
FROM_EMAIL=info@0xherstory.cn
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# 批量初始化板子的专用64位小写hex密钥；与统一固件一致，留空则关闭新设备登记。
DEVICE_ENROLLMENT_KEY=
