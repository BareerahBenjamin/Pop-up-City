{
  "name": "herstory-popup-city-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "preview:dashboard": "node scripts/preview-dashboard.mjs",
    "migrate": "node --env-file=.env manage.js migrate",
    "admin": "node --env-file=.env manage.js admin",
    "test": "node scripts/check-hardware-boundary.mjs && node --test test/*.test.js",
    "backup": "node --env-file=.env backup.js",
    "build:planet": "node scripts/build-planet.cjs",
    "test:planet:browser": "node test/planet-browser.mjs",
    "check:hardware": "node scripts/check-hardware-boundary.mjs",
    "test:hardware": "node scripts/check-hardware-boundary.mjs && node --test test/hardware*.test.js test/device*.test.js test/host-batches.test.js test/event-policy.test.js test/avatar-visual.test.js test/pixel-name.test.js"
  },
  "dependencies": {
    "nodemailer": "10.0.12",
    "qrcode": "1.5.4",
    "sharp": "0.35.5"
  }
}
